# ============================================================
# Environment Configuration — Native (no Docker)
# All services run directly on localhost
# ============================================================

# ---- Database: Auth Service (PostgreSQL) ----
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=authpassword123
AUTH_DB_NAME=authdb
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
DATABASE_URL=postgresql://authuser:authpassword123@localhost:5432/authdb

# ---- Database: Winner Worker (PostgreSQL) ----
ORDER_DB_USER=orderuser
ORDER_DB_PASSWORD=orderpassword123
ORDER_DB_NAME=orderdb
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432

# ---- Database: Product Service (MongoDB) ----
MONGO_DB_NAME=productdb
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_URI=mongodb://localhost:27017/productdb

# ---- Broker: Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- JWT ----
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-make-this-very-long-and-secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---- Service ports ----
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=8001

PRODUCT_SERVICE_HOST=localhost
PRODUCT_SERVICE_PORT=8002

RAFFLE_SERVICE_HOST=localhost
RAFFLE_SERVICE_PORT=8003

# ---- Frontend ----
REACT_APP_AUTH_SERVICE_URL=http://localhost:8001
REACT_APP_PRODUCT_SERVICE_URL=http://localhost:8002
REACT_APP_RAFFLE_SERVICE_URL=http://localhost:8003
REACT_APP_FRONTEND_PORT=3000

# ---- Winner Worker ----
PRODUCT_SERVICE_URL=http://localhost:8002
POLLING_INTERVAL=1
