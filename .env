# Environment Configuration for Sneaker Store Microservices

# Service URLs (Docker internal)
AUTH_SERVICE_URL=http://auth-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
RAFFLE_SERVICE_URL=http://raffle-service:8003

# Database - Auth Service
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=authpassword123
AUTH_DB_NAME=authdb
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
DATABASE_URL=postgresql://authuser:authpassword123@auth-db:5432/authdb

# Database - Order/Winner Service
ORDER_DB_USER=orderuser
ORDER_DB_PASSWORD=orderpassword123
ORDER_DB_NAME=orderdb
ORDER_DB_HOST=order-db
ORDER_DB_PORT=5432

# Database - Product Service
MONGO_DB_NAME=productdb
MONGO_DB_HOST=product-db
MONGO_DB_PORT=27017
MONGO_URI=mongodb://root:password@product-db:27017/productdb?authSource=admin

# Redis - Raffle Queue Broker
REDIS_HOST=redis-broker
REDIS_PORT=6379
REDIS_DB=0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-make-this-very-long-and-secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Auth Service
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8001

# Product Service
PRODUCT_SERVICE_HOST=product-service
PRODUCT_SERVICE_PORT=8002

# Raffle Service
RAFFLE_SERVICE_HOST=raffle-service
RAFFLE_SERVICE_PORT=8003

# Frontend
REACT_APP_AUTH_SERVICE_URL=http://localhost:8001
REACT_APP_PRODUCT_SERVICE_URL=http://localhost:8002
REACT_APP_RAFFLE_SERVICE_URL=http://localhost:8003
REACT_APP_FRONTEND_PORT=3000

# Load Tester
LOCUST_HOST=http://auth-service:8001
LOCUST_USERS=5000
LOCUST_SPAWN_RATE=100
